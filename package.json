{
  "name": "task-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready task management system (Trello/ClickUp/Asana-inspired)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "lint": "npm --workspace client run lint",
    "start": "npm --workspace server run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
